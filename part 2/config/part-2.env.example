# Calm non-secret variables. Set these as runtime/profile variables.
DB_NAME=poll_app
DB_USER=poll_app
DB_PORT=5432
DB_HOST=<postgres-service-ip>
BACKEND_CIDR=<backend-subnet-cidr>
APP_PORT=8080
APP_REPOSITORY_URL=https://github.com/<owner>/<repository>.git
APP_REF=main
APP_DIR=/opt/poll-app
APP_USER=pollapp
API_BASE_URL=http://<backend-service-ip>:8080

# Calm secret variables. Keep actual values outside Git.
DB_PASSWORD=<calm-secret>
JWT_SECRET=<calm-secret>
SERVICE_ACCOUNT_PASSWORD=<calm-secret>
SERVICE_ACCOUNT_PASSWORD_HASH=<bcrypt-hash-secret>
SERVICE_ACCOUNT_USERNAME=service_account
GITHUB_TOKEN=<calm-secret-if-private-repository>
